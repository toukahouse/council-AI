# Environment variables declared in this file are automatically loaded by Prisma and the Server.

# Prisma Postgres Connection String (Required)
DATABASE_URL="postgresql://user:password@host/database"

# Gemini API Key (Required for standard Gemini API access)
GEMINI_API_KEY="your_gemini_api_key_here"

# AI Proxy Settings (Required for Antigravity Proxy workaround)
GEMINI_COOKIE_1PSID="your_1PSID_cookie_here"
GEMINI_COOKIE_1PSIDTS="your_1PSIDTS_cookie_here"

# Browser used for cookie extraction (e.g., edge, chrome)
BROWSER_NAME="edge"

# Model selection
GEMINI_MODEL="gemini-3-pro-plus"
